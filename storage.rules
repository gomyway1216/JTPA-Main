rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isEditor() {
      return isSignedIn() && request.auth.token.editor == true;
    }

    // Raster image types only. Excludes SVG (image/svg+xml) deliberately —
    // SVGs can carry markup that some downstream tools execute, and we don't
    // need vector uploads anywhere in the app today.
    function isImage() {
      return request.resource.contentType in [
        'image/png',
        'image/jpeg',
        'image/webp',
        'image/gif',
      ];
    }

    function maxSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Event cover images: public read, admin write.
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && maxSize(10);
    }

    // Presentation files: public read, presenter or admin write.
    match /presentations/{eventId}/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if ((isSignedIn() && request.auth.uid == uid) || isAdmin())
        && maxSize(50);
    }

    // Project (Showcase) assets: public read for thumbnails/screenshots,
    // owner can write their own folder, admin can write any.
    match /projects/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if ((isSignedIn() && request.auth.uid == uid) || isAdmin())
        && isImage() && maxSize(5);
    }

    // Blog post images (cover image + inline body images): public read,
    // author writes their own folder, admin writes any. Same shape as
    // projects/. Split delete from create/update so deletes don't null-eval
    // through isImage()/maxSize() (`request.resource` is null on delete).
    match /posts/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if ((isSignedIn() && request.auth.uid == uid) || isAdmin())
        && isImage() && maxSize(5);
      allow delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
    }

    // User avatars
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (isSignedIn() && request.auth.uid == uid)
        && isImage() && maxSize(2);
    }

    // Guide images (embedded in Markdown body): public read. With the
    // contributor flow, guides are no longer admin/editor-only — any
    // signed-in user submitting a guide may need to embed images. The
    // path is `guides/{guideId}/{uid}/{filename}` (mirroring the Q&A
    // layout) so writes can be constrained to the uploader's own
    // sub-folder: a user can't drop files into someone else's guide
    // on the client. Admin/editor can always write/delete anywhere.
    // Note: legacy guides may still hold images at the old flat path
    // `guides/{guideId}/{filename}` (created before this PR);
    // `deleteFiles({prefix})` in `deleteGuide` still sweeps those up
    // because the prefix matches both layouts.
    match /guides/{guideId}/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if ((isSignedIn() && request.auth.uid == uid)
          || isAdmin() || isEditor())
        && isImage() && maxSize(5);
      allow delete: if (isSignedIn() && request.auth.uid == uid)
        || isAdmin() || isEditor();
    }

    // Legacy guide image path (no uid segment) — only admin/editor can
    // touch these. Kept so existing guides created before the
    // contributor flow keep their write/delete semantics; new uploads
    // go through the path above. Once all legacy assets are migrated
    // this block can be removed.
    match /guides/{guideId}/{filename} {
      allow read: if true;
      allow create, update: if (isAdmin() || isEditor())
        && isImage() && maxSize(5);
      allow delete: if isAdmin() || isEditor();
    }

    // Q&A images (embedded in Markdown body). The path is
    // `qa/{qaId}/{uid}/{filename}` so we can constrain writes to the
    // uploader's own subfolder — a user can't drop files into someone
    // else's Q&A on the client. Reads are public. Same 5MB cap as the
    // other body-image endpoints.
    match /qa/{qaId}/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if ((isSignedIn() && request.auth.uid == uid) || isAdmin())
        && isImage() && maxSize(5);
      allow delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
    }
  }
}
