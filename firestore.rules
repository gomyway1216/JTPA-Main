rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isEditor() {
      return isSignedIn() && request.auth.token.editor == true;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Returns true when every entry in `opts` has `voteCount == 0`.
    // Firestore rules has no array `.every()`, so we unroll up to the
    // server-enforced MAX_OPTIONS (8). The `opts.size() < N` guard on
    // each line short-circuits when fewer options are present so the
    // index access doesn't fault. Used by the polls create rule to
    // block clients from publishing a poll with pre-inflated option
    // counts while `voterCount == 0`.
    function optionsAllZero(opts) {
      return (opts.size() < 1 || opts[0].voteCount == 0)
        && (opts.size() < 2 || opts[1].voteCount == 0)
        && (opts.size() < 3 || opts[2].voteCount == 0)
        && (opts.size() < 4 || opts[3].voteCount == 0)
        && (opts.size() < 5 || opts[4].voteCount == 0)
        && (opts.size() < 6 || opts[5].voteCount == 0)
        && (opts.size() < 7 || opts[6].voteCount == 0)
        && (opts.size() < 8 || opts[7].voteCount == 0);
    }

    // ----- users -----
    // Profile docs. Owner can read/write own, admin can read all.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }

    // ----- events -----
    // Public reads any non-cancelled event where visibility is not
    // 'members_only'. Older docs missing the visibility field are treated as
    // public (the `!=` comparison returns true for missing fields). Members-
    // only events still need a signed-in user. Admins always pass.
    match /events/{eventId} {
      allow read: if (
        (resource.data.status == 'published' || resource.data.status == 'past')
        && (resource.data.visibility != 'members_only' || isSignedIn())
      ) || isAdmin();
      allow create, update, delete: if isAdmin();

      // ----- rsvps subcollection -----
      // User can manage own RSVP doc. Admin can read/write all.
      match /rsvps/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid;
        allow update: if (isSelf(uid)
          && request.resource.data.uid == resource.data.uid)
          || isAdmin();
        allow delete: if isSelf(uid) || isAdmin();
      }

      // ----- presentations subcollection -----
      // Public can read for published events. Presenter or admin can write.
      match /presentations/{presentationId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.presenterUid == request.auth.uid;
        allow update: if (isSignedIn()
          && resource.data.presenterUid == request.auth.uid)
          || isAdmin();
        allow delete: if (isSignedIn()
          && resource.data.presenterUid == request.auth.uid)
          || isAdmin();
      }
    }

    // ----- projects (Showcase) -----
    // Anyone signed in can submit. Admin approves. Public reads only approved.
    match /projects/{projectId} {
      allow read: if resource.data.status == 'approved'
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewerUid == null
        // `likeCount` must be absent or zero on create. Without this, a
        // client could seed an inflated like count that surfaces once
        // admin approves the project — the denormalized counter is only
        // ever supposed to grow via the `toggleLikeRecord` Server Action.
        && (!('likeCount' in request.resource.data)
            || request.resource.data.likeCount == 0);

      // Owner can edit metadata but cannot change status/reviewer fields.
      // Editing flips status back to 'pending' for re-review. `likeCount`
      // is denormalized and only the Server Action should touch it, so
      // owners can't update it via a direct client write either —
      // pinning it to its current value blocks that path.
      allow update: if (
        isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.reviewerUid == resource.data.reviewerUid
        && request.resource.data.status == 'pending'
        && (
          (!('likeCount' in request.resource.data)
            && !('likeCount' in resource.data))
          || request.resource.data.likeCount == resource.data.likeCount
        )
      ) || isAdmin();

      allow delete: if (isSignedIn()
        && resource.data.ownerUid == request.auth.uid)
        || isAdmin();

      // Per-project likes — server-action-only (matches posts/guides/qa).
      // Toggling goes through `toggleLikeRecord` Server Action so the
      // denormalized `likeCount` on the parent stays coherent.
      match /likes/{uid} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      // Comments on showcase projects. Reads gated on the project
      // being publicly approved (or the user is the owner / admin /
      // comment author). Note projects use `status == 'approved'`
      // rather than `'published'` like posts/guides/qa do. Owner is
      // explicitly allowed because a project in pending / rejected
      // status still has a moderation queue, and the owner should be
      // able to see what people commented during that window.
      match /comments/{commentId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource != null
              && resource.data.authorUid == request.auth.uid)
          || get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'approved'
          || (isSignedIn()
              && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid);

        // Schema invariants enforced on create so a malicious client
        // can't write a doc whose `parentType` / `parentId` claim a
        // different parent than the path the rule is matching.
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.parentType == 'project'
          && request.resource.data.parentId == projectId
          && get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'approved';

        // Authors can edit ONLY their comment body (plus the
        // `updatedAt` timestamp).
        allow update: if isAdmin()
          || (
            isSignedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['body', 'updatedAt', 'deletedAt'])
          );

        // Hard delete is admin-only. Authors soft-delete via the Server
        // Action (`deleteComment`), which sets `deletedAt` through the
        // update rule above.
        allow delete: if isAdmin();

        // Per-comment likes — same Server-Action-only policy.
        match /likes/{uid} {
          allow read: if true;
          allow create, update, delete: if false;
        }
      }
    }

    // ----- guides (AI setup / help content) -----
    // Published guides are public. Drafts only readable by admin/editor.
    // Editors and admins can write.
    // Note: privileged checks run first so `resource` (null when the doc
    // doesn't exist) isn't dereferenced for admins/editors who must still
    // be able to probe missing docs without hitting a null-eval failure.
    match /guides/{guideId} {
      allow read: if isAdmin() || isEditor()
        || (resource != null && resource.data.status == 'published');
      allow create, update, delete: if isAdmin() || isEditor();

      // Per-guide likes are read-only for clients. All toggles flow
      // through the `toggleLikeRecord` Server Action (Admin SDK) so the
      // denormalized `likeCount` on the parent doc stays in sync — direct
      // client writes would create like docs without touching the counter
      // and the next server-side toggle could drive it negative.
      match /likes/{uid} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      // Comments on guides. Mirror posts/{id}/comments. Reads gated on
      // the parent guide being published (so draft guide comments don't
      // leak via guessed ids); author and admin always see their own.
      match /comments/{commentId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource != null
              && resource.data.authorUid == request.auth.uid)
          || get(/databases/$(database)/documents/guides/$(guideId)).data.status == 'published';

        // Schema invariants enforced on create so a malicious client
        // can't write a doc whose `parentType` / `parentId` claim a
        // different parent than the path the rule is matching.
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.parentType == 'guide'
          && request.resource.data.parentId == guideId
          && get(/databases/$(database)/documents/guides/$(guideId)).data.status == 'published';

        // Authors can edit ONLY their comment body (plus the `updatedAt`
        // timestamp). Without this allowlist, a client write could
        // overwrite `likeCount`, `parentCommentId`, or `parentType` —
        // bypassing the server-side validation our Server Actions do.
        allow update: if isAdmin()
          || (
            isSignedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['body', 'updatedAt', 'deletedAt'])
          );

        // Hard delete is admin-only. Authors soft-delete via the Server
        // Action (`deleteComment`), which sets `deletedAt` through the
        // update rule above.
        allow delete: if isAdmin();

        // Per-comment likes on a guide comment. Same Server-Action-only
        // policy as the record-level likes above.
        match /likes/{uid} {
          allow read: if true;
          allow create, update, delete: if false;
        }
      }
    }

    // ----- blog posts -----
    // Published posts are public. All other states (draft, pending, rejected,
    // archived) are only visible to the author and admins. Write paths
    // normally go through Server Actions, but the rules enforce the same
    // invariants in case a client ever calls Firestore directly.
    match /posts/{postId} {
      allow read: if isAdmin()
        || (resource != null && resource.data.status == 'published')
        || (isSignedIn() && resource != null
            && resource.data.authorUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ['draft', 'pending']
        && request.resource.data.reviewerUid == null;

      // Authors can edit their own posts but can NOT self-publish. Allowed
      // owner-update destinations are 'draft' (save without resubmitting)
      // or 'pending' (resubmit for review). authorUid + reviewerUid must
      // stay the same so an author can't reassign ownership or fake a
      // reviewer. Admins can change anything.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.reviewerUid == resource.data.reviewerUid
          && request.resource.data.status in ['draft', 'pending']
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // Per-post likes are read-only for clients. All toggles flow
      // through the `toggleLikeRecord` Server Action (Admin SDK) so the
      // denormalized `likeCount` on the parent doc stays in sync — direct
      // client writes would create like docs without touching the counter
      // and the next server-side toggle could drive it negative.
      match /likes/{uid} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      // Comments live under the post. Reads are gated on the parent post
      // being publicly readable — otherwise comments on a draft / rejected
      // post would leak metadata about its existence. Author and admin
      // always see their own.
      match /comments/{commentId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource != null
              && resource.data.authorUid == request.auth.uid)
          || get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published';

        // Schema invariants enforced on create so a malicious client
        // can't write a doc whose `parentType` / `parentId` claim a
        // different parent than the path the rule is matching.
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.parentType == 'post'
          && request.resource.data.parentId == postId
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published';

        // Authors can edit ONLY their comment body (plus the `updatedAt`
        // timestamp). Without this allowlist, a client write could
        // overwrite `likeCount`, `parentCommentId`, or `parentType` —
        // bypassing the server-side validation our Server Actions do.
        allow update: if isAdmin()
          || (
            isSignedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['body', 'updatedAt', 'deletedAt'])
          );

        // Hard delete is admin-only. Authors soft-delete via the Server
        // Action (`deleteComment`), which sets `deletedAt` through the
        // update rule above.
        allow delete: if isAdmin();

        // Per-comment likes. Same Server-Action-only policy as the
        // record-level likes above.
        match /likes/{uid} {
          allow read: if true;
          allow create, update, delete: if false;
        }
      }
    }

    // ----- Q&A (community-posted questions / tips) -----
    // Any signed-in user can submit; no review queue. Admin can flip
    // status to 'archived' to hide spam. Reads: 'published' is public;
    // archived is admin + author only (so the author can see their own
    // moderated post and ask why).
    match /qa/{qaId} {
      allow read: if isAdmin()
        || (resource != null && resource.data.status == 'published')
        || (isSignedIn() && resource != null
            && resource.data.authorUid == request.auth.uid);

      // Create gate: only the doc author can write a doc for themselves,
      // it must start `published` with `likeCount == 0`, and the
      // create-time timestamps must match `request.time`. Without these,
      // a client could bypass the Server Action to seed a doc with an
      // inflated `likeCount`, backdated timestamps, or someone else's
      // `authorUid`/`authorName`.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'published'
        && (!('likeCount' in request.resource.data)
            || request.resource.data.likeCount == 0)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Update gate: authors can edit only the listed content fields and
      // must keep `authorUid` / `status` unchanged. Admin can change
      // anything (incl. archiving). The `affectedKeys().hasOnly(...)`
      // allowlist blocks a malicious client from punching `likeCount`,
      // `createdAt`, `authorUid`, etc. via a raw Firestore write — the
      // Server Action goes through Admin SDK and bypasses these rules
      // anyway, so we lose nothing by being strict here.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'body', 'tags', 'slug', 'updatedAt'])
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // Per-Q&A likes — server-action-only (matches posts/guides).
      match /likes/{uid} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      // Comments on Q&A. Same shape as posts/guides comments.
      match /comments/{commentId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource != null
              && resource.data.authorUid == request.auth.uid)
          || get(/databases/$(database)/documents/qa/$(qaId)).data.status == 'published';

        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.parentType == 'qa'
          && request.resource.data.parentId == qaId
          && get(/databases/$(database)/documents/qa/$(qaId)).data.status == 'published';

        allow update: if isAdmin()
          || (
            isSignedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['body', 'updatedAt', 'deletedAt'])
          );

        // Hard delete is admin-only. Authors soft-delete via the Server
        // Action (`deleteComment`), which sets `deletedAt` through the
        // update rule above.
        allow delete: if isAdmin();

        match /likes/{uid} {
          allow read: if true;
          allow create, update, delete: if false;
        }
      }
    }

    // ----- polls (community-posted polls / votes) -----
    // Mirrors `qa/` but adds a `votes/{uid}` subcollection. Voting flows
    // through the `castPollVote` Server Action (Admin SDK), which writes
    // the ballot doc AND increments the denormalized per-option
    // voteCount + voterCount in one transaction — direct client writes
    // would let a ballot land without the counter moving, so we deny
    // them entirely.
    match /polls/{pollId} {
      allow read: if isAdmin()
        || (resource != null && resource.data.status == 'published')
        || (isSignedIn() && resource != null
            && resource.data.authorUid == request.auth.uid);

      // Create gate: only the doc author can write a doc for themselves,
      // it must start `published` with zero denormalized counters
      // (including every option's `voteCount`), and the create-time
      // timestamps must match `request.time`. Without these, a client
      // could bypass the Server Action to seed inflated counts,
      // backdated timestamps, or someone else's `authorUid`.
      //
      // The `options[].voteCount` check uses a helper that walks the
      // array — there's no Firestore-rules array-quantifier primitive,
      // so we cap at MAX_OPTIONS (8) and short-circuit on the first
      // non-zero. Anything longer than that is rejected upstream by
      // Zod, so the cap is a safe assumption here.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.voterCount == 0
        && (!('likeCount' in request.resource.data)
            || request.resource.data.likeCount == 0)
        && request.resource.data.options.size() <= 8
        && optionsAllZero(request.resource.data.options)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Update gate: authors can edit only the listed content fields.
      // `options` is intentionally NOT in the allowlist — it embeds the
      // denormalized `voteCount` per option, and option-list edits
      // (which happen pre-vote) flow through `updateMyPoll` via Admin
      // SDK, bypassing these rules. Leaving `options` out blocks a
      // direct client write from tampering with the per-row counters
      // even while `voterCount` looks unchanged. Admin can change
      // anything; the freeze-while-voted invariant is enforced
      // server-side inside `updateMyPoll`'s transaction.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.voterCount == resource.data.voterCount
          && (
            (!('likeCount' in request.resource.data)
              && !('likeCount' in resource.data))
            || request.resource.data.likeCount == resource.data.likeCount
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'description', 'slug', 'updatedAt'])
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // Per-poll likes — server-action-only (matches qa/posts/guides).
      match /likes/{uid} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      // Ballots. Reads are restricted to the ballot owner (and admins)
      // — the doc id is the voter's uid, so a public-read rule would
      // tie individual selections to specific accounts for anyone who
      // enumerates the path. The UI loads the current user's ballot
      // server-side via Admin SDK (`getMyPollVote`), which bypasses
      // these rules; aggregate results stay readable via the parent
      // doc's `options[].voteCount` and `voterCount`.
      //
      // All writes flow through `castPollVote` so direct client writes
      // are denied — the denormalized counters can never desync from
      // the ballot docs.
      match /votes/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      // Comments on polls. Same shape as qa/posts/guides comments.
      match /comments/{commentId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource != null
              && resource.data.authorUid == request.auth.uid)
          || get(/databases/$(database)/documents/polls/$(pollId)).data.status == 'published';

        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.parentType == 'poll'
          && request.resource.data.parentId == pollId
          && get(/databases/$(database)/documents/polls/$(pollId)).data.status == 'published';

        allow update: if isAdmin()
          || (
            isSignedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['body', 'updatedAt', 'deletedAt'])
          );

        // Hard delete is admin-only. Authors soft-delete via the Server
        // Action (`deleteComment`), which sets `deletedAt` through the
        // update rule above.
        allow delete: if isAdmin();

        match /likes/{uid} {
          allow read: if true;
          allow create, update, delete: if false;
        }
      }
    }

    // ----- site pages (admin-edited static-ish content) -----
    // One doc per slug under `sitePages/{slug}` (e.g. `about`). All writes
    // flow through the `saveSitePage` Server Action (Admin SDK), which
    // bypasses these rules; we deny client-side writes entirely so the
    // Zod validation + updatedBy/updatedAt invariants can't be skipped by
    // a direct client write (matches the `mail/` lockdown below).
    match /sitePages/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // ----- mail (Trigger Email extension) -----
    // Only admins (server) can enqueue mail directly. Server Actions use Admin SDK.
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
