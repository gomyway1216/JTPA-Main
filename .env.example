# Public Firebase Web SDK config (safe to expose to the browser — HTTP
# referrer restrictions are set on the API key in GCP Console).
# Copy these from Firebase Console → Project settings → 全般 → マイアプリ → Web → SDK の設定:
#   https://console.firebase.google.com/u/0/project/jtpa-main/settings/general
#
# Local development can use the default firebaseapp.com auth domain. Production
# on bayarea-ai.com must set NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bayarea-ai.com so
# Firebase Auth uses the same-site helper paths proxied by next.config.ts.
# next dev/test falls back to a demo-shaped config when these are blank so
# pages do not crash at import time. Real sign-in/uploads still need real
# values here or NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jtpa-main.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jtpa-main
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jtpa-main.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Used by the Admin SDK to identify the project. Same value as
# NEXT_PUBLIC_FIREBASE_PROJECT_ID; kept separate so server-only code never
# has to import the NEXT_PUBLIC_ variant.
FIREBASE_PROJECT_ID=jtpa-main

# Optional: set to 'true' to talk to local Firebase emulators (auth:9099,
# firestore:8080, storage:9199) instead of production. Leave unset for
# normal local dev hitting the real backend.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Optional: comma-separated recipients for admin notification mails (new
# project submissions etc). Only matters once the Firebase Trigger Email
# extension is installed (see docs/admin.md).
# ADMIN_NOTIFICATION_EMAILS=admin@example.org

# Optional: JSON-stringified service-account key. Most contributors should
# NOT set this — instead run `gcloud auth application-default login` so
# the Admin SDK picks up your user credentials via ADC. Only set this if
# you genuinely need an explicit service-account identity.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
