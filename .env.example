# Firebase Web SDK (safe to expose; bundled into client). Get these from
# Firebase Console → Project Settings → Your apps → SDK setup and config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jtpa-main.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jtpa-main
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jtpa-main.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only. Used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_COOKIE_SECRET=

# Firebase Admin credentials for local dev.
# In production (App Hosting / Cloud Run), Application Default Credentials are
# picked up automatically via the runtime service account.
# Locally: download a service account JSON from Firebase Console
# (Project Settings → Service Accounts) and set the path here.
GOOGLE_APPLICATION_CREDENTIALS=

# Toggle Firebase emulators (true | false)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Recipients of "new project submitted" notifications (comma-separated).
# Leave empty to disable admin notifications.
ADMIN_NOTIFICATION_EMAILS=
